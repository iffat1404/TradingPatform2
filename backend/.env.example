# TEMPLATE — committed to git. Never put real keys in this file.
# Copy it to `.env` (same folder) and fill your keys in there; `.env` is gitignored.

# ---------------------------------------------------------------------------
# Which LLM backend to use
# ---------------------------------------------------------------------------
#   gemini     Google Gemini direct  (default)
#   anthropic  Echios LiteLLM proxy  (Nomura training)
#   none       disable AI entirely — deterministic fallbacks only, zero spend
GENAI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
# Key from https://aistudio.google.com/apikey (current format looks like AQ.Ab8...)
GEMINI_API_KEY=
# gemini-flash-latest works and has its own quota pool.
# NOTE: gemini-2.5-flash is retired for new keys; gemini-2.0-flash free-tier daily quota
# can exhaust quickly.
GEMINI_MODEL=gemini-flash-latest

# ---------------------------------------------------------------------------
# Echios LiteLLM proxy (only used when GENAI_PROVIDER=anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://llm-2.echios.tech
# Models the proxy serves: nova-micro (cheapest), claude-haiku-4-5, claude-sonnet-4-6.
# Public Anthropic model IDs (claude-3-5-sonnet-...) do NOT exist on the proxy.
GENAI_MODEL=nova-micro

# Ceiling on tokens per response — each call keeps its own tuned value, this only clamps
# them down. Lower it to cut spend; 1024 leaves all current calls untouched.
GENAI_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# App settings (override only if you need to)
# ---------------------------------------------------------------------------
# SECRET_KEY=change-me-in-production
# DATABASE_URL=sqlite:///./nomura_stp.db
